# ─────────────────────────────────────────────────────────────
# 28 — Environment variables
# Copy to `.env.local` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://28tribeca.com

# --- Consultation form routing -------------------------------
# The API route works out-of-the-box in development (it logs
# submissions to the server console). To deliver leads to a real
# destination, set ONE of the following and wire it in
# app/api/consultation/route.ts (see the TODO markers there).

# Option A — Resend (transactional email). https://resend.com
RESEND_API_KEY=
CONSULTATION_TO_EMAIL=concierge@28tribeca.com
CONSULTATION_FROM_EMAIL=website@28tribeca.com

# Option B — Generic webhook (HubSpot / Zoho / Salesforce / Zapier)
CONSULTATION_WEBHOOK_URL=

# --- Analytics (optional) ------------------------------------
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
